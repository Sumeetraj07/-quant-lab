# =============================================================================
# QuantLab — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_USER=quantlab
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=quantlab
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Full DSN (constructed from above in development)
DATABASE_URL=postgresql+asyncpg://quantlab:change_me_in_production@localhost:5432/quantlab

# Sync DSN (for Alembic migrations)
DATABASE_SYNC_URL=postgresql+psycopg2://quantlab:change_me_in_production@localhost:5432/quantlab

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# Celery broker and backend (uses Redis)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ---------------------------------------------------------------------------
# Authentication / Security
# ---------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_to_a_random_256_bit_hex_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------------------------------------------------------------------------
# Market Data Providers
# ---------------------------------------------------------------------------
# Alpha Vantage — free tier: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here

# ---------------------------------------------------------------------------
# AI Research Assistant (Phase 19)
# ---------------------------------------------------------------------------
# Set to "gemini" or "openai"
AI_PROVIDER=gemini
GOOGLE_API_KEY=your_google_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------------------------------------------------------------------------
# Frontend (Vite)
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_TITLE=QuantLab
